.page {
  min-height: 100vh;
  background: #f8fafc;
  padding: 30rpx;
}

.nav .title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  margin: 16rpx 0 30rpx;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  font-size: 26rpx;
  color: #64748b;
  display: block;
  margin-bottom: 12rpx;
}

.picker,
.input {
  background: #fff;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  background: #fff;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.submit {
  margin-top: 20rpx;
  background: #2563eb;
  color: #fff;
  border-radius: 12rpx;
}

.hint {
  display: block;
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #94a3b8;
  text-align: center;
}
