.page { min-height: 100vh; background: #f8fafc; padding-bottom: 40rpx; }
.nav-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 60rpx 30rpx 20rpx; background: #fff; border-bottom: 1px solid #f1f5f9;
}
.nav-back { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; }
.back-icon { font-size: 40rpx; color: #1e293b; font-weight: bold; }
.nav-title { font-size: 34rpx; font-weight: 700; color: #1e293b; }
.nav-placeholder { width: 64rpx; }
.filter-section {
  background: #fff; margin: 20rpx 30rpx; border-radius: 16rpx; padding: 24rpx 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.filter-row { margin-bottom: 16rpx; }
.filter-row:last-child { margin-bottom: 0; }
.filter-label { font-size: 26rpx; color: #64748b; margin-right: 16rpx; }
.filter-tags { display: inline-flex; flex-wrap: wrap; gap: 12rpx; }
.filter-tag {
  padding: 8rpx 20rpx; border-radius: 999rpx; font-size: 24rpx;
  color: #64748b; background: #f1f5f9;
}
.filter-tag.active { background: #f97316; color: #fff; }
.loading, .empty { text-align: center; padding: 80rpx; color: #94a3b8; font-size: 28rpx; }
.sample-list { padding: 0 30rpx; }
.sample-card {
  background: #fff; border-radius: 16rpx; padding: 24rpx 30rpx; margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.sample-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.sample-year { font-size: 32rpx; font-weight: 700; color: #1e293b; }
.sample-badge { font-size: 22rpx; color: #f97316; background: #ffedd5; padding: 4rpx 12rpx; border-radius: 8rpx; }
.sample-title { display: block; font-size: 30rpx; font-weight: 600; color: #1e293b; margin-bottom: 8rpx; }
.sample-topic { display: block; font-size: 24rpx; color: #64748b; margin-bottom: 8rpx; }
.sample-meta { display: block; font-size: 22rpx; color: #94a3b8; }
