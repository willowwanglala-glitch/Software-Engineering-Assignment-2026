<view class="page">
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack"><text class="back-icon">←</text></view>
    <text class="nav-title">作文范文库</text>
    <view class="nav-placeholder"></view>
  </view>

  <view class="filter-section">
    <view class="filter-row">
      <text class="filter-label">考试</text>
      <view class="filter-tags">
        <view
          class="filter-tag {{activeExam === item.id ? 'active' : ''}}"
          wx:for="{{examTypes}}"
          wx:key="id"
          bindtap="onExamFilter"
          data-id="{{item.id}}"
        >{{item.label}}</view>
      </view>
    </view>
    <view class="filter-row">
      <text class="filter-label">类型</text>
      <view class="filter-tags">
        <view
          class="filter-tag {{activeEssay === item.id ? 'active' : ''}}"
          wx:for="{{essayTypes}}"
          wx:key="id"
          bindtap="onEssayFilter"
          data-id="{{item.id}}"
        >{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <view class="sample-list" wx:else>
    <view class="sample-card" wx:for="{{sampleList}}" wx:key="_id" bindtap="openDetail" data-id="{{item._id}}">
      <view class="sample-head">
        <text class="sample-year">{{item.year}}</text>
        <text class="sample-badge">{{item.examLabel}} · {{item.typeLabel}}</text>
      </view>
      <text class="sample-title">{{item.title}}</text>
      <text class="sample-topic">{{item.topic}}</text>
      <text class="sample-meta">约 {{item.wordCount}} 词 · {{item.source}}</text>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !sampleList.length}}">暂无范文</view>
</view>
