.legal-page {
  min-height: 100vh;
  background: #f8fafc;
}

.legal-nav {
  padding: 24rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #e2e8f0;
}

.back {
  font-size: 28rpx;
  color: #2563eb;
}

.title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  margin-top: 16rpx;
  color: #1e293b;
}

.legal-body {
  height: calc(100vh - 160rpx);
  padding: 30rpx;
  box-sizing: border-box;
}

.meta {
  display: block;
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 24rpx;
}

.h {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  margin: 28rpx 0 12rpx;
}

.p {
  display: block;
  font-size: 28rpx;
  color: #475569;
  line-height: 1.75;
  margin-bottom: 16rpx;
}

.link {
  display: block;
  font-size: 26rpx;
  color: #2563eb;
  margin-top: 32rpx;
  margin-bottom: 40rpx;
}
