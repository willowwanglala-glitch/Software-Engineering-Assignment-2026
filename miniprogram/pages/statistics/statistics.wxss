.page {
  min-height: 100vh;
  background: #f8fafc;
  padding-bottom: 120rpx;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 30rpx 20rpx;
  background: #ffffff;
  border-bottom: 1px solid #f1f5f9;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
}

/* Banner */
.banner {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  margin: 24rpx 30rpx;
  border-radius: 16rpx;
  padding: 36rpx 30rpx;
  display: flex;
  flex-direction: column;
}

.banner-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.banner-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

/* 2x2统计网格 */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 0 30rpx;
  margin-bottom: 24rpx;
  justify-content: center;
}

.stat-item {
  width: calc(50% - 10rpx);
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.circle-progress {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.circle-inner {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.circle-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #2563eb;
}

.circle-unit {
  font-size: 20rpx;
  color: #64748b;
  margin-left: 2rpx;
}

.stat-simple {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.simple-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #2563eb;
}

.simple-unit {
  font-size: 22rpx;
  color: #64748b;
  margin-left: 4rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #64748b;
}

/* Section通用 */
.section {
  background: #ffffff;
  border-radius: 16rpx;
  margin: 0 30rpx 24rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 20rpx;
  display: block;
}

/* 日历 */
.calendar-header {
  display: flex;
  margin-bottom: 12rpx;
}

.cal-day {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  font-weight: 600;
}

.calendar-body {
  display: flex;
  flex-wrap: wrap;
}

.cal-cell {
  width: calc(100% / 7);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
  position: relative;
}

.cal-date {
  font-size: 24rpx;
  color: #334155;
}

.cal-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #2563eb;
  margin-top: 4rpx;
}

/* 柱状图 */
.chart-wrap {
  padding: 20rpx 0;
}

.chart-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 300rpx;
}

.bar-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.bar {
  width: 40rpx;
  background: linear-gradient(to top, #2563eb, #3b82f6);
  border-radius: 8rpx 8rpx 0 0;
  min-height: 10rpx;
}

.bar-label {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

.bar-value {
  font-size: 20rpx;
  color: #64748b;
  margin-top: 4rpx;
}

/* 专注记录 */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1px solid #f1f5f9;
}

.record-item:last-child {
  border-bottom: none;
}

.record-left {
  display: flex;
  flex-direction: column;
}

.record-mode {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.record-task {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.record-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.record-time {
  font-size: 22rpx;
  color: #94a3b8;
}

.record-duration {
  font-size: 26rpx;
  font-weight: 600;
  color: #2563eb;
  margin-top: 4rpx;
}

.empty-tip {
  padding: 40rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 26rpx;
  color: #94a3b8;
}

/* 底部占位 */
.bottom-placeholder {
  height: calc(50px + env(safe-area-inset-bottom) + 20rpx);
}