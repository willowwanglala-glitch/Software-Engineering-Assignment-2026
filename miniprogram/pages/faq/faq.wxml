<view class="page">
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack"><text class="back-icon">←</text></view>
    <text class="nav-title">备考 FAQ</text>
    <view class="nav-placeholder"></view>
  </view>

  <scroll-view class="cat-scroll" scroll-x>
    <view class="cat-list">
      <view
        class="cat-item {{activeCategory === item ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="*this"
        bindtap="onCategoryTap"
        data-category="{{item}}"
      >{{item}}</view>
    </view>
  </scroll-view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <view class="faq-list" wx:else>
    <view class="faq-card" wx:for="{{faqList}}" wx:key="_id">
      <view class="faq-q" bindtap="openDetail" data-id="{{item._id}}">
        <text class="faq-tag">{{item.category}}</text>
        <text class="faq-question">{{item.question}}</text>
        <text class="faq-arrow">›</text>
      </view>
      <view class="faq-actions">
        <text class="action-btn" bindtap="askAi" data-question="{{item.question}}">问 AI</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !faqList.length}}">暂无 FAQ</view>
</view>
