.page { min-height: 100vh; background: #f8fafc; }
.nav-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 60rpx 30rpx 20rpx; background: #fff; border-bottom: 1px solid #f1f5f9;
}
.nav-back { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; }
.back-icon { font-size: 40rpx; color: #1e293b; font-weight: bold; }
.nav-title { font-size: 34rpx; font-weight: 700; color: #1e293b; }
.nav-placeholder { width: 64rpx; }
.cat-scroll { background: #fff; white-space: nowrap; padding: 16rpx 0; }
.cat-list { display: inline-flex; padding: 0 24rpx; gap: 16rpx; }
.cat-item {
  display: inline-block; padding: 12rpx 28rpx; border-radius: 999rpx;
  font-size: 26rpx; color: #64748b; background: #f1f5f9;
}
.cat-item.active { background: #3b82f6; color: #fff; }
.loading, .empty { text-align: center; padding: 80rpx; color: #94a3b8; font-size: 28rpx; }
.faq-list { padding: 20rpx 30rpx; }
.faq-card {
  background: #fff; border-radius: 16rpx; margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); overflow: hidden;
}
.faq-q { display: flex; align-items: flex-start; padding: 24rpx 30rpx; gap: 12rpx; }
.faq-tag {
  flex-shrink: 0; font-size: 22rpx; color: #3b82f6; background: #dbeafe;
  padding: 4rpx 12rpx; border-radius: 8rpx;
}
.faq-question { flex: 1; font-size: 28rpx; color: #1e293b; line-height: 1.5; }
.faq-arrow { color: #cbd5e1; font-size: 32rpx; }
.faq-actions { padding: 0 30rpx 20rpx; }
.action-btn { font-size: 24rpx; color: #3b82f6; }
