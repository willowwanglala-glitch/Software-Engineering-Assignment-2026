.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #2563eb, #1d4ed8, #1e40af);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.login-card {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.logo-icon {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  border-radius: 24rpx;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.slogan {
  font-size: 28rpx;
  color: #64748b;
}

.agree-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-bottom: 32rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #cbd5e1;
  border-radius: 8rpx;
  margin-right: 12rpx;
  font-size: 22rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox.checked {
  background: #2563eb;
  border-color: #2563eb;
}

.agree-text {
  color: #64748b;
}

.agree-link {
  color: #2563eb;
}

.login-tip {
  font-size: 22rpx;
  color: #94a3b8;
  text-align: center;
  margin-top: 16rpx;
}

.demo-section {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed #e2e8f0;
}

.demo-toggle {
  text-align: center;
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 20rpx;
}

.form-area {
  display: flex;
  flex-direction: column;
}

.wechat-btn {
  margin-top: 0;
}

.input-group {
  margin-bottom: 32rpx;
}

.input-label {
  font-size: 28rpx;
  color: #475569;
  margin-bottom: 12rpx;
  display: block;
}

.input-field {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1e293b;
  background: #f8fafc;
  box-sizing: border-box;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  border: none;
  line-height: 88rpx;
}

.login-btn::after {
  border: none;
}

.switch-mode {
  margin-top: 32rpx;
  text-align: center;
}

.switch-text {
  font-size: 26rpx;
  color: #2563eb;
}

.wechat-btn {
  margin-top: 24rpx;
  background: #07c160 !important;
  color: #fff !important;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.wechat-btn::after {
  border: none;
}

.ghost-btn {
  margin-top: 16rpx;
  background: #f1f5f9 !important;
  color: #2563eb !important;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.ghost-btn::after {
  border: none;
}

.mode-hint {
  display: block;
  text-align: center;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #94a3b8;
}
