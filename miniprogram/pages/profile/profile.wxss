.page {
  min-height: 100vh;
  background: #f8fafc;
  padding-bottom: 120rpx;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 30rpx 20rpx;
  background: #ffffff;
  border-bottom: 1px solid #f1f5f9;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
}

/* 用户信息卡片 */
.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #ffffff;
  margin: 24rpx 30rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.avatar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.avatar-wrap {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-fallback {
  width: 100%;
  height: 100%;
  background: #2563eb;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-badge {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(37, 99, 235, 0.92);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.avatar-tip {
  font-size: 20rpx;
  color: #2563eb;
  margin-top: 8rpx;
  text-align: center;
  max-width: 140rpx;
}

/* 预设头像弹层 */
.ai-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.ai-sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.ai-sheet-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.ai-sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.ai-sheet-close {
  font-size: 44rpx;
  color: #94a3b8;
  line-height: 1;
  padding: 0 8rpx;
}

.ai-sheet-desc {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.preset-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.preset-item {
  width: 30%;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  padding: 8rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.preset-item.active {
  border-color: #2563eb;
  background: #eff6ff;
}

.preset-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #f1f5f9;
}

.preset-name {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #64748b;
  text-align: center;
}

.ai-actions {
  display: flex;
  gap: 16rpx;
}

.ai-btn {
  flex: 1;
  margin: 0;
  font-size: 28rpx;
  border-radius: 12rpx;
  line-height: 2.2;
}

.ai-btn::after {
  border: none;
}

.ai-btn.secondary {
  background: #f1f5f9;
  color: #334155;
}

.ai-btn.primary {
  background: #2563eb;
  color: #ffffff;
}

.ai-btn[disabled] {
  opacity: 0.5;
}

.nick-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.nick-input {
  flex: 1;
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
  border-bottom: 1rpx solid #e2e8f0;
  padding: 4rpx 0;
}

.save-btn {
  font-size: 26rpx;
  color: #2563eb;
  flex-shrink: 0;
}

.avatar-letter {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.user-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
}

.user-school {
  font-size: 26rpx;
  color: #64748b;
}

.user-edit {
  font-size: 24rpx;
  color: #2563eb;
  margin-top: 8rpx;
}

/* 三列统计 */
.stats-row {
  display: flex;
  align-items: center;
  background: #ffffff;
  margin: 0 30rpx 24rpx;
  border-radius: 16rpx;
  padding: 30rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #2563eb;
}

.stat-label {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: #e2e8f0;
}

/* 管理后台卡片 */
.admin-card {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  margin: 0 30rpx 24rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  position: relative;
}

.admin-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
}

.admin-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
  display: block;
}

.admin-arrow {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.8);
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
}

/* 菜单列表 */
.menu-list {
  background: #ffffff;
  margin: 0 30rpx 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1px solid #f1f5f9;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon-text {
  font-size: 32rpx;
  color: #2563eb;
  margin-right: 20rpx;
  width: 40rpx;
  text-align: center;
}

.menu-name {
  flex: 1;
  font-size: 28rpx;
  color: #334155;
}

.menu-arrow {
  font-size: 28rpx;
  color: #94a3b8;
}

/* 退出登录 */
.logout-wrap {
  padding: 0 30rpx;
  margin-top: 20rpx;
}

.logout-btn {
  text-align: center;
  padding: 24rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #ef4444;
  background: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 底部占位 */
.bottom-placeholder {
  height: 100rpx;
}