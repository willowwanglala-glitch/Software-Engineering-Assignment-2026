.page {
  min-height: 100vh;
  background: #f8fafc;
  padding: 30rpx;
}

.header {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.school-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
}

.sub {
  font-size: 26rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.user-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.avatar-img,
.avatar-letter {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.avatar-letter {
  background: #2563eb;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
}

.name {
  display: block;
  font-size: 30rpx;
  color: #1e293b;
}

.dir {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #94a3b8;
  font-size: 28rpx;
}
