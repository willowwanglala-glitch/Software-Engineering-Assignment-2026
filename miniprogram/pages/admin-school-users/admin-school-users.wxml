<view class="page">
  <view class="header">
    <text class="school-name">{{schoolName}}</text>
    <text class="sub">共 {{users.length}} 位用户选择该院校</text>
  </view>
  <view class="list" wx:if="{{users.length}}">
    <view class="user-row" wx:for="{{users}}" wx:key="_id">
      <image class="avatar-img" wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill"></image>
      <view class="avatar-letter" wx:else>{{item.nickName[0] || '用'}}</view>
      <view class="info">
        <text class="name">{{item.nickName}}</text>
        <text class="dir">{{item.direction || '未设置方向'}}</text>
      </view>
    </view>
  </view>
  <view class="empty" wx:else>
    <text>暂无用户选择该院校</text>
  </view>
</view>
