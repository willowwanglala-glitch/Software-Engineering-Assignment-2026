page {
  background-color: #f8fafc;
  color: #1e293b;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 14px;
  line-height: 1.5;
  box-sizing: border-box;
}

view, text, input, textarea, button, scroll-view, picker {
  box-sizing: border-box;
}

/* 安全区域适配（来自 english-kaoyanbao4） */
.safe-bottom {
  padding-bottom: calc(50px + env(safe-area-inset-bottom));
}

.safe-bottom-sm {
  padding-bottom: calc(20rpx + 50px + env(safe-area-inset-bottom));
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
